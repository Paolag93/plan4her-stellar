{
  "name": "plan4her-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual.spec.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:domain": "node src/domain/domain.test.cjs && node src/domain/taskSelection.test.cjs && node src/domain/cyclePreferences.test.cjs && node src/domain/community.test.cjs && node src/domain/encryption.test.cjs && node src/domain/rhythmPreview.test.cjs",
    "test:server": "node server/api.test.ts",
    "start": "node server/index.ts",
    "testnet:smoke": "esbuild scripts/testnet-vault-smoke.ts --bundle --platform=node --format=cjs --alias:@stellar/freighter-api=./scripts/testnet-stub-freighter.js --outfile=.testnet-smoke.cjs --log-level=warning && NODE_USE_ENV_PROXY=1 node .testnet-smoke.cjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.1.1",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^14.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
