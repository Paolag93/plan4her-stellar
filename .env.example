# Server-side only. Set these in your hosting provider's environment settings.
# Never commit real values and never prefix them with VITE_ (that would publish them).
PINATA_JWT=
# Optional dedicated gateway host, e.g. your-name.mypinata.cloud (defaults to gateway.pinata.cloud)
PINATA_GATEWAY=
# public (default) or private
PINATA_NETWORK=public
# Shared demo access code that unlocks IPFS upload for judges/testers
DEMO_ACCESS_CODE=
# 32+ random characters used to sign short-lived session tokens
SESSION_SECRET=
